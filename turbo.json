{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "FEEDBACK_INGRESS_SECRET",
    "FEEDBACK_TRUSTED_CLIENT_IP_HEADER",
    "NEXT_PUBLIC_*",
    "NODE_ENV",
    "VERCEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "type-check": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "clean": {
      "cache": false
    }
  }
}
