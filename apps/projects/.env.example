NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_DOMAIN=localhost
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CALLBACK_URL=
NEXT_PUBLIC_SENTRY_DSN=
# Generate at least 32 random bytes and use the same value in the API.
FEEDBACK_INGRESS_SECRET=
# Non-Vercel production only: this header must be overwritten by a trusted proxy.
FEEDBACK_TRUSTED_CLIENT_IP_HEADER=

# Shared public link previews (server-only; never NEXT_PUBLIC_).
# Redis caches metadata and coordinates refreshes. Existing APP_REDIS_* server
# settings are supported as a fallback when PREVIEW_REDIS_URL is omitted.
# PREVIEW_REDIS_URL=rediss://:password@redis.internal:6379/0
# APP_REDIS_HOST=redis.internal
# APP_REDIS_PORT=6379
# APP_REDIS_PASSWORD=
# APP_REDIS_DB=0
# APP_REDIS_DISABLE_TLS=false
# Private S3-compatible image cache. PREVIEW_S3_* overrides matching APP_AWS_*
# settings. Grant only GetObject/PutObject on previews/external/v1/*.
# Configure a bucket lifecycle rule expiring this prefix after 7 days BEFORE
# production rollout. The app rejects older objects but does not delete them.
# PREVIEW_S3_BUCKET=fortyone
# PREVIEW_S3_REGION=us-east-1
# PREVIEW_S3_ENDPOINT=
# PREVIEW_S3_ACCESS_KEY_ID=
# PREVIEW_S3_SECRET_ACCESS_KEY=
# PREVIEW_S3_FORCE_PATH_STYLE=false
