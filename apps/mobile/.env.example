# Public values are embedded in the app. Use the team's trusted development origins.
EXPO_PUBLIC_API_URL=https://api.example.invalid
EXPO_PUBLIC_APP_URL=https://app.example.invalid

# Optional public Sentry DSN. Reporting stays disabled in development and when blank.
EXPO_PUBLIC_SENTRY_DSN=

# Local builds must not upload symbols/source maps to Sentry.
SENTRY_DISABLE_AUTO_UPLOAD=true
# The managed release environment supplies SENTRY_ORG, SENTRY_PROJECT, and a secret
# SENTRY_AUTH_TOKEN. Never put the token in an EXPO_PUBLIC variable or commit it.
