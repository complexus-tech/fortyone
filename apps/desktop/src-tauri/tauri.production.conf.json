{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FortyOne",
  "identifier": "app.fortyone.desktop",
  "build": {
    "devUrl": null,
    "frontendDist": "https://cloud.fortyone.app"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "fortyone-desktop"
        ]
      }
    },
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
