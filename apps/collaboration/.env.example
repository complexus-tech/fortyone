# Use the same PostgreSQL database as the Go API. Migration 194 is required.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/fortyone
# Required in production; mount the database provider's CA certificate.
# DATABASE_CA_FILE=/run/secrets/database-ca.pem
COLLABORATION_ALLOWED_ORIGINS=http://localhost:3000
PORT=1234
# Required when more than one collaboration instance runs.
# COLLABORATION_REDIS_HOST=127.0.0.1
# COLLABORATION_REDIS_PORT=6379
# COLLABORATION_REDIS_PASSWORD=
# COLLABORATION_REDIS_TLS=true
