{
  "openapi": "3.1.1",
  "info": {
    "title": "FortyOne Agent API",
    "version": "1.0.0",
    "description": "Machine-readable contract for FortyOne discovery, health, and the user-authorized remote MCP endpoint.",
    "contact": { "name": "FortyOne", "email": "hello@complexus.tech", "url": "https://www.fortyone.app/contact" }
  },
  "servers": [{ "url": "https://api.fortyone.app", "description": "Production" }],
  "externalDocs": { "description": "FortyOne developer resources", "url": "https://www.fortyone.app/developers" },
  "paths": {
    "/openapi.json": { "get": { "operationId": "getOpenAPIDescription", "description": "Returns the OpenAPI 3.1 description for automatic client discovery.", "responses": { "200": { "description": "OpenAPI description" } } } },
    "/liveness": { "get": { "operationId": "getAPILiveness", "description": "Confirms that the FortyOne API process is running.", "responses": { "200": { "description": "API process is alive" } } } },
    "/readiness": { "get": { "operationId": "getAPIReadiness", "description": "Confirms whether the API and database are ready.", "responses": { "200": { "description": "API is ready" }, "503": { "description": "API is not ready" } } } },
    "/mcp": { "post": { "operationId": "sendMCPMessage", "description": "Sends an authenticated JSON-RPC message to the stateless FortyOne Streamable HTTP MCP endpoint.", "security": [{ "oauth2": ["mcp:access"] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "JSON-RPC response" }, "401": { "description": "OAuth bearer token required" } } } },
    "/.well-known/oauth-protected-resource": { "get": { "operationId": "getOAuthProtectedResourceMetadata", "description": "Returns RFC 9728 authorization metadata for the FortyOne MCP resource.", "responses": { "200": { "description": "Protected resource metadata" } } } },
    "/.well-known/oauth-authorization-server": { "get": { "operationId": "getOAuthAuthorizationServerMetadata", "description": "Returns OAuth authorization-server metadata for MCP clients.", "responses": { "200": { "description": "Authorization server metadata" } } } }
  },
  "components": { "securitySchemes": { "oauth2": { "type": "oauth2", "flows": { "authorizationCode": { "authorizationUrl": "https://api.fortyone.app/oauth/authorize", "tokenUrl": "https://api.fortyone.app/oauth/token", "scopes": { "mcp:access": "Use the FortyOne MCP tools as the connected user" } } } } } }
}
