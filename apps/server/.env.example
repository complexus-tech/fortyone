# Runtime. Security decisions use this single mode; email delivery behavior has
# its own APP_EMAIL_ENVIRONMENT setting.
APP_ENVIRONMENT=development

# Database
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=fortyone
APP_DB_MAX_OPEN_CONNS=25
# database/sql idle budget for the API's startup migration runner only. Native
# API and worker pgx pools use APP_DB_MAX_CONN_IDLE_TIME instead.
APP_DB_MAX_IDLE_CONNS=25
# Upper bound for each statement executed by the API startup migration runner.
APP_DB_MIGRATION_STATEMENT_TIMEOUT=30m
APP_DB_MIN_CONNS=0
APP_DB_CONNECT_TIMEOUT=10s
APP_DB_MAX_CONN_IDLE_TIME=30m
APP_DB_MAX_CONN_LIFETIME=1h
APP_DB_HEALTH_CHECK_PERIOD=1m
# Local PostgreSQL only. Use verify-full for an external database.
APP_DB_SSL_MODE=disable
# Optional CA path in the API/worker runtime, or system for OS trust roots.
APP_DB_SSL_ROOT_CERT=
# Deprecated compatibility fallback used only when APP_DB_SSL_MODE is empty.
APP_DB_DISABLE_TLS=true

# Google (legacy fallback, use APP_AUTH_GOOGLE_CLIENT_IDS instead)
GOOGLE_CLIENT_ID=
# Auth
APP_AUTH_SECRET_KEY=
# Dedicated key for feedback verification-code digests, unsubscribe links, and
# widget-secret encryption. The API and worker must share this value. Replace
# the development default with at least 32 random bytes in production and do
# not reuse any auth, token, OAuth, or credential-vault key.
APP_FEEDBACK_SECURITY_KEY=development-only-feedback-security-key
# Shared only by the API and worker email-reply ingress. It authenticates the
# Brevo webhook and encrypts its durable payloads. Never reuse the browser-auth
# secret or any other application key.
APP_EMAIL_REPLY_SECURITY_KEY=development-only-email-reply-security-key
# Shared only by API and worker replicas that issue or confirm assistant story
# mutations. Use independent random key material in production.
APP_MESSAGING_MUTATION_HMAC_KEY=development-only-messaging-mutation-hmac-key
# Separate versioned key for email verification code HMACs and opaque abuse
# counters. Generate at least 32 random bytes; never reuse APP_AUTH_SECRET_KEY.
APP_VERIFICATION_TOKEN_HMAC_KEY=development-only-verification-hmac-key
APP_VERIFICATION_TOKEN_HMAC_KEY_ID=v1
# Separate versioned HMAC key for invitation-token digests. The API and worker
# must share the active keyring during rotation; never reuse either auth key.
APP_INVITATION_TOKEN_HMAC_KEY=development-only-invitation-hmac-key
APP_INVITATION_TOKEN_HMAC_KEY_ID=v1
# Optional comma-separated old-key-id=secret entries during a bounded rotation.
APP_INVITATION_TOKEN_HMAC_PREVIOUS_KEYS=
# Shared envelope-encryption keyring for retained GitHub and Slack OAuth
# credentials. Production must replace this public development key with an
# independent 32-byte random KEK from the managed secret store.
APP_CREDENTIAL_VAULT_ACTIVE_KEY_ID=development
APP_CREDENTIAL_VAULT_ACTIVE_KEY_VERSION=1
APP_CREDENTIAL_VAULT_KEYS={"development@1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
# Dedicated versioned HMAC keyring for PAT and service-account key digests.
# Production must replace this public development key with independent random
# 32-byte material and retain old entries only while issued keys still use them.
APP_API_CREDENTIAL_HMAC_ACTIVE_KEY_ID=development
APP_API_CREDENTIAL_HMAC_ACTIVE_KEY_VERSION=1
APP_API_CREDENTIAL_HMAC_KEYS={"development@1":"ZGV2ZWxvcGVyLWNyZWRlbnRpYWwtZGV2LWtleS0wMDE="}
# Dedicated OAuth keys for delegated MCP clients. The access-token signing key
# and authorization/refresh-token digest keyring must be independent from each
# other and from every credential key above. Replace all development values in
# production and retain old digest keys only for their bounded token lifetime.
APP_OAUTH_ACCESS_TOKEN_SIGNING_KEY=oauth-development-access-sign-01
APP_OAUTH_TOKEN_HMAC_ACTIVE_KEY_ID=development
APP_OAUTH_TOKEN_HMAC_KEYS={"development":"b2F1dGgtZGV2ZWxvcG1lbnQtZGlnZXN0LWtleS0wMDE="}
# Dynamic public clients are intentionally time-bounded (1h minimum, 90d max).
APP_OAUTH_DYNAMIC_CLIENT_TTL=720h
# Enable on exactly one controlled worker during a documented KEK rotation.
# The worker authenticates and compare-and-swap rewraps GitHub and Slack
# credentials before it reports ready. Disable again after verification.
APP_CREDENTIAL_VAULT_REWRAP_ON_STARTUP=false
APP_AUTH_COOKIE_DOMAIN=
APP_AUTH_GOOGLE_CLIENT_IDS=
APP_AUTH_GOOGLE_CLIENT_SECRET=
APP_AUTH_GOOGLE_REDIRECT_URL=
APP_AUTH_GOOGLE_CALENDAR_REDIRECT_URL=http://localhost:8000/integrations/calendar/google/callback
# Required for automatic Google Calendar sync outside local development. Set
# the same public HTTPS URL in the API and worker environments.
APP_AUTH_GOOGLE_CALENDAR_WEBHOOK_URL=
APP_AUTH_MICROSOFT_CLIENT_ID=
APP_AUTH_MICROSOFT_CLIENT_SECRET=
APP_AUTH_MICROSOFT_TENANT=common
APP_AUTH_MICROSOFT_REDIRECT_URL=http://localhost:8000/auth/microsoft/callback
APP_AUTH_MICROSOFT_CALENDAR_REDIRECT_URL=http://localhost:8000/integrations/calendar/microsoft/callback
# Required for automatic Outlook Calendar sync outside local development. Set
# the same public HTTPS URL in the API and worker environments.
APP_AUTH_MICROSOFT_CALENDAR_WEBHOOK_URL=
# Generate at least 32 random bytes and use the same value in the Projects app.
FEEDBACK_INGRESS_SECRET=
# OpenAI
OPENAI_API_KEY=
# Optional overrides; the worker defaults to these values when omitted.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_USER_CALLS_PER_MINUTE=12
OPENAI_ASSISTANT_WORKSPACE_CALLS_PER_MINUTE=120
OPENAI_ASSISTANT_WORKSPACE_TOKENS_PER_DAY=1000000
# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Shared by the API and worker only for encrypted Slack webhook inbox bodies.
# Replace in production and never reuse auth, provider-signing, OAuth,
# provider-credential, or credential-vault key material.
APP_SLACK_WEBHOOK_PAYLOAD_SECRET=development-only-slack-webhook-payload-secret
# Optional outside local development; the API defaults to this production URL.
SLACK_REDIRECT_URL=https://api.fortyone.app/integrations/slack/setup
# Redis
APP_REDIS_HOST=127.0.0.1
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0
APP_REDIS_DISABLE_TLS=true
APP_REDIS_DIAL_TIMEOUT=10s
APP_REDIS_READ_TIMEOUT=30s
APP_REDIS_WRITE_TIMEOUT=30s
# API and worker can override this independently in their deployment tasks.
APP_REDIS_POOL_SIZE=30
# APP
APP_API_HOST=0.0.0.0:8000
APP_API_PUBLIC_URL=http://localhost:8000
# Exact comma-separated browser origins. Wildcards and parent-domain matching
# are rejected; production origins must use HTTPS.
APP_API_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_API_DEBUG_HOST=localhost:9000
APP_MCP_LOGIN_URL=http://localhost:3000
APP_API_READ_HEADER_TIMEOUT=10s
APP_API_READ_TIMEOUT=5m
APP_API_WRITE_TIMEOUT=5m
APP_API_IDLE_TIMEOUT=60s
APP_API_SHUTDOWN_TIMEOUT=30s
APP_API_READINESS_CHECK_TIMEOUT=2s
APP_API_TELEMETRY_SHUTDOWN_TIMEOUT=5s
# Worker health server. Keep this port on a private network. Queue monitoring is
# disabled unless explicitly enabled and is mounted at /admin/queues.
APP_WORKER_HTTP_HOST=0.0.0.0:8080
APP_WORKER_HTTP_READ_HEADER_TIMEOUT=5s
APP_WORKER_HTTP_READ_TIMEOUT=10s
APP_WORKER_HTTP_WRITE_TIMEOUT=15s
APP_WORKER_HTTP_IDLE_TIMEOUT=60s
APP_WORKER_HTTP_SHUTDOWN_TIMEOUT=15s
APP_WORKER_MONITOR_ENABLED=false
APP_WORKER_MONITOR_USERNAME=
# Required and at least 32 random bytes in production when monitoring is enabled.
APP_WORKER_MONITOR_PASSWORD=
APP_WEBSITE_URL=http://localhost:3000
APP_TRACING_ENDPOINT=http://localhost:4318
# Optional comma-separated/JSON map accepted by the config parser for OTLP auth.
APP_TRACING_HEADERS=
# SMTP/email delivery
APP_EMAIL_HOST=smtp.gmail.com
APP_EMAIL_PORT=587
APP_EMAIL_USERNAME=
APP_EMAIL_PASSWORD=
APP_EMAIL_FROM_ADDRESS=
APP_EMAIL_FROM_NAME=FortyOne
APP_EMAIL_MAYA_FROM_ADDRESS=maya@fortyone.app
APP_EMAIL_MAYA_FROM_NAME=Maya, AI Agent
APP_EMAIL_ENVIRONMENT=development
APP_EMAIL_BASE_DIR=.
# Storage Provider
APP_STORAGE_PROVIDER=aws
STORAGE_PROFILE_IMAGES_NAME=profiles
STORAGE_WORKSPACE_LOGOS_NAME=logos
STORAGE_ATTACHMENTS_NAME=attachments

# Azure Storage
APP_AZURE_STORAGE_ACCOUNT_KEY=
APP_AZURE_STORAGE_CONNECTION_STRING=
APP_AZURE_STORAGE_ACCOUNT_NAME=

# AWS S3 Storage
# Optional paired static credential for approved local S3-compatible development. Leave unset in production so ECS task-role credentials are used.
APP_AWS_ACCESS_KEY_ID=
# Optional paired local credential; must be set together with APP_AWS_ACCESS_KEY_ID and is rejected in production.
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_REGION=
APP_AWS_ENDPOINT=
APP_AWS_PUBLIC_URL=
APP_AWS_FORCE_PATH_STYLE=
APP_AWS_BUCKET=fortyone
# GitHub Integration
APP_GITHUB_APP_ID=

# Figma OAuth integration
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URL=http://localhost:8000/integrations/figma/callback
FIGMA_WEBHOOK_URL=
# Shared by the API and worker only for encrypted Figma webhook inbox bodies.
# Replace in production and never reuse auth, feedback, invitation, OAuth,
# webhook-passcode, provider-credential, or credential-vault key material.
APP_FIGMA_WEBHOOK_PAYLOAD_SECRET=development-only-figma-webhook-payload-secret
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_REDIRECT_URL=
GITHUB_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=
# Shared by the API and worker only for encrypted GitHub webhook inbox bodies.
# Replace in production and never reuse auth, provider-signing, OAuth,
# provider-credential, or credential-vault key material.
APP_GITHUB_WEBHOOK_PAYLOAD_SECRET=development-only-github-webhook-payload-secret
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Brevo
APP_BREVO_API_KEY=
