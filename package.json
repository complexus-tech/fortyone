{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:projects": "pnpm --filter projects dev",
    "dev:desktop": "pnpm --filter desktop desktop:dev",
    "check:desktop": "pnpm --filter desktop desktop:check",
    "build:desktop": "pnpm --filter desktop desktop:build",
    "package:desktop": "pnpm --filter desktop desktop:package",
    "ios26": "pnpm --filter mobile ios26",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:desktop:hosted": "pnpm --filter desktop desktop:dev:hosted",
    "release:desktop": "pnpm --filter desktop desktop:release"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tailwindcss": "4.3.3",
    "tsconfig": "workspace:*",
    "turbo": "^2.7.2"
  },
  "packageManager": "pnpm@9.3.0",
  "name": "fortyone.app",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@expo/metro-config>lightningcss": "1.30.1"
    },
    "patchedDependencies": {
      "hyperellipse@1.0.5": "patches/hyperellipse@1.0.5.patch"
    }
  }
}
